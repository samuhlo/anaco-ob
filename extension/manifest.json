{
  "manifest_version": 2,
  "name": "Anaco",
  "version": "0.11.0",
  "default_locale": "es",
  "description": "__MSG_manifest_description__",
  "browser_specific_settings": {
    "gecko": {
      "id": "anaco-ob@samuhlo",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  },
  "permissions": [
    "activeTab",
    "menus",
    "storage",
    "nativeMessaging",
    "tabs",
    "webNavigation"
  ],
  "optional_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "i18n-catalog.js",
      "i18n.js",
      "media-source.js",
      "detection.js",
      "embeds.js",
      "stream.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "__MSG_manifest_action_title__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "sidebar_action": {
    "default_title": "Anaco",
    "default_panel": "panel.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "open_at_install": false
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "capture-page": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_manifest_command_capture__"
    }
  },
  "content_security_policy": "script-src 'self'; object-src 'none'",
  "short_name": "Anaco",
  "incognito": "not_allowed",
  "homepage_url": "https://github.com/samuhlo/anaco-ob",
  "author": "samuhlo"
}
